{
  "name": "shankala",
  "private": true,
  "description": "Shankala — Hong Kong street food in Edmonton. Cloudflare Python Worker + D1.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply shankala-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply shankala-db --remote",
    "test": "python3 -m unittest discover -s tests -v"
  },
  "devDependencies": {
    "wrangler": "^4"
  }
}
